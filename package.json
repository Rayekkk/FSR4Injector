{
  "name": "fsr4injector",
  "version": "1.0.1",
  "description": "DeckyLoader plugin: official AMD FSR 4.1 Lite for RDNA 3.5 APUs under Proton",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "rollup -c && node scripts/check-build.mjs",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs",
    "test:backend": "python -m unittest discover -s tests -p \"test_*.py\" -v",
    "test:frontend": "node tests/frontend_panel.cjs"
  },
  "devDependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.12.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/react": "^19.1.1",
    "rollup": "^4.0.0",
    "rollup-plugin-external-globals": "^0.13.0",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0"
  }
}
